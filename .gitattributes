# Auto-detect text files and normalize line endings
* text=auto

# Unity YAML assets: keep as text so they diff and merge
*.unity       text eol=lf
*.prefab      text eol=lf
*.mat         text eol=lf
*.asset       text eol=lf
*.meta        text eol=lf
*.controller  text eol=lf
*.anim        text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.lighting    text eol=lf
*.playable    text eol=lf
*.mask        text eol=lf
*.brush       text eol=lf
*.flare       text eol=lf
*.fontsettings text eol=lf
*.guiskin     text eol=lf
*.giparams    text eol=lf
*.renderTexture text eol=lf
*.spriteatlas text eol=lf
*.terrainlayer text eol=lf
*.mixer       text eol=lf
*.shadervariants text eol=lf
*.preset      text eol=lf
*.inputactions text eol=lf
*.cs          text diff=csharp
*.shader      text
*.hlsl        text
*.cginc       text
*.uss         text
*.uxml        text
*.tss         text
*.json        text
*.txt         text

# Unity binary data
*.cubemap     filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text
*.wlt         filter=lfs diff=lfs merge=lfs -text
LightingData.asset filter=lfs diff=lfs merge=lfs -text
*.bytes       filter=lfs diff=lfs merge=lfs -text

